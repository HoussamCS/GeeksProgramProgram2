   "metadata": {},
   "source": [
    "### Data preparaion"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "eba2a816",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import ipywidgets as widgets\n",
    "from ipywidgets import interact, Dropdown, IntSlider\n",
    "from IPython.display import display\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "df = pd.read_csv('superstore_dataset.csv')\n",
    "print(df.shape)\n",
    "df.info()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b888dee0",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = df.drop_duplicates()\n",
    "df['Postal Code'] = df['Postal Code'].fillna(0)\n",
    "\n",
    "date_columns = ['Order Date', 'Ship Date']\n",
    "for col in date_columns:\n",
    "    df[col] = pd.to_datetime(df[col])\n",
    "    \n",
    "df['Profit Margin'] = (df['Profit'] / df['Sales']) * 100\n",
    "df['Order Year'] = df['Order Date'].dt.year\n",
    "df['Order Month-Year'] = df['Order Date'].dt.to_period('M')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "067a7440",
   "metadata": {},
   "source": [
    "### Deep-Dive Exploratory "
   ]
  },
  {
   "cell_type": "markdown",
   "id": "16d2418e",
   "metadata": {},
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "82b42149",
   "metadata": {},
   "outputs": [],
   "source": [
    "from ipywidgets import interact, Dropdown\n",
    "\n",
    "categories = ['All'] + list(df['Category'].unique())\n",
    "\n",
    "def plot_monthly_sales(category='All'):\n",
    "    plt.figure(figsize=(12, 6))\n",
    "    monthly_sales = df.groupby(['Order Month-Year', 'Category'])['Sales'].sum().reset_index()\n",
    "    monthly_sales['Date'] = monthly_sales['Order Month-Year'].dt.to_timestamp()\n",
    "\n",
    "    if category == 'All':\n",
    "        total_sales = df.groupby('Order Month-Year')['Sales'].sum()\n",
    "        plt.plot(total_sales.index.to_timestamp(), total_sales.values, marker='o')\n",
    "    else:\n",
    "        cat_data = monthly_sales[monthly_sales['Category'] == category]\n",
    "        plt.plot(cat_data['Date'], cat_data['Sales'], marker='o')\n",
    "\n",
    "    plt.title(f'Monthly Sales Trend - {category}')\n",
    "    plt.xlabel('Date'); plt.ylabel('Sales ($)')\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.grid(True, alpha=0.3)\n",
    "    plt.show()\n",
    "\n",
    "interact(plot_monthly_sales, category=Dropdown(options=categories))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ef1a6221",
   "metadata": {},
   "outputs": [],
   "source": [
    "state_sales = df.groupby('State')['Sales'].sum().sort_values()\n",
    "\n",
    "def plot_top_states(top_n=10):\n",
    "    plt.figure(figsize=(12, max(6, top_n * 0.4)))\n",
    "    top_states = state_sales.tail(top_n)\n",
    "    plt.barh(top_states.index, top_states.values, color='steelblue')\n",
    "    plt.title(f'Top {top_n} States by Sales')\n",
    "    plt.xlabel('Sales ($)')\n",
    "    plt.grid(axis='x', alpha=0.3)\n",
    "    plt.show()\n",
    "\n",
    "interact(plot_top_states, top_n=IntSlider(min=5, max=25, value=10))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "461d53ff",
   "metadata": {},
   "source": [
    "### Top 10 Most Profitable Products"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b900b45d",
   "metadata": {},
   "outputs": [],
   "source": [
    "product_profit = df.groupby('Product Name')['Profit'].sum().nlargest(10)\n",
    "plt.figure(figsize=(12, 8))\n",
    "sns.barplot(x=product_profit.values, y=product_profit.index, palette='viridis')\n",
    "plt.title('Top 10 Most Profitable Products')\n",
    "plt.xlabel('Profit ($)'); plt.ylabel('Product')\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "87b8aca7",
   "metadata": {},
   "source": [
    "### Discount vs Profit (Category Hue)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "edadb8ce",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(14, 8))\n",
    "sns.scatterplot(data=df, x='Discount', y='Profit', hue='Category', alpha=0.6)\n",
    "sns.regplot(data=df, x='Discount', y='Profit', scatter=False, color='red', linestyle='--')\n",
    "plt.axhline(y=0, color='black', alpha=0.5)\n",
    "plt.title('Discount vs Profit by Category')\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d552755a",
   "metadata": {},
   "source": [
    "### Executive Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "81eb8f6b",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=== EXECUTIVE SUMMARY ===\")\n",
    "total_sales = df['Sales'].sum()\n",
    "total_profit = df['Profit'].sum()\n",
    "profit_margin = (total_profit / total_sales) * 100\n",
    "\n",
    "print(f\"• Total Revenue: ${total_sales:,.0f}\")\n",
    "print(f\"• Total Profit: ${total_profit:,.0f}\")\n",
    "print(f\"• Profit Margin: {profit_margin:.1f}%\")\n",
    "print()\n",
    "print(f\"• Most Profitable Product: {product_profit.index[0]}\")\n",
    "print(f\"• Top Performing State: {state_sales.index[-1]}\")\n"
   ]
  },
